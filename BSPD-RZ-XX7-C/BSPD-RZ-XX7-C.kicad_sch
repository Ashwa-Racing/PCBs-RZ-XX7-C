	(text "Normally LOW\nPlausibility being low charges the cap for 10s, \nwhich gives a HIGH\nPlausibility is (Implausibility + Q_bar)\n(which are normally LOW and HIGH respectively)"
		(exclude_from_sim no)
		(at 286.766 102.362 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0799fe0e-7b15-4d2b-914b-1e9b600643ba")
	)
	(text "Normally gives a LOW (Q)\nR (PoR + 10s) gives HIGH, to reset to LOW\nS (0.5s) gives HIGH, to set to HIGH"
		(exclude_from_sim no)
		(at 409.448 49.276 0)

	(text "On-board power calculations\n1) LM339s : 2.5mA * 2 = 5mA\n2) LM393  : 2.5mA\n3) SN74HC32 : 160uA (including buffer for IO) = 0.16mA\n4) SN74HC02N : 160uA (including buffer for IO) = 0.16mA\n5) Passives : 10mA\n6) Plus regulator current + led = 5 + 0.5 = 5.5mA\n7) TLV9002 : 240uA (including buffer for IO) = 0.24mA\nTotal current = 23.56mA \nDrop : 9.4*22.46mA = 0.221464W\nMax junction temperature : 73.57568C (with 47 ambient temperature)"
		(exclude_from_sim no)
		(at 271.78 261.874 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1fcba3fd-b2a9-4121-9b8e-71a513ff833c")
	)

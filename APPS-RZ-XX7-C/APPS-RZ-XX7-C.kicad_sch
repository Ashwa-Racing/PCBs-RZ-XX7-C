	(text "For programming\nInitial setup is:\nInitial value of \nAPS1 = ~\nAPS2 = ~\nTPS1 = 1.1V\nTPS2 = 3.9V\nPlausibility = 1\nTimer = 0\nRelay = 1\nETB Control = 1\nFirst time startup = wait 1s\n\nLoop the below\n1) Every 10ms SCAN ADC\n2) First check SCS (APSx & TPSx != 3.3V/0V) \n(If false, turn off Relay = 0) (Else Relay = 1 )\n3) Check APS1 == APS2 or (abs(APS2 - APS1/2) >= 0.1*APS2) or (abs(5V-TPS1 - TPS2) >= 0.1*TPS2) \n(If true & timer = 1 don't do anything, else turn on timer for 100ms, timer = 1, plausibility to be 0) \n(Else Turn timer off, timer = 0)\n4) If timer runs out before, turn plausibility = 0 and ETB Control to 0. Delay of 1s."
		(exclude_from_sim no)
		(at 306.832 80.518 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "15030048-12da-485c-99cd-01662564a1c0")
	)
